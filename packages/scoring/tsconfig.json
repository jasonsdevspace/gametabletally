{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // The sources and their tests together, which the tests run in Node. The build's own
        // config takes the sources alone with no environment's globals, so the package runs
        // in a browser, in Node and in a phone's script runtime alike.
        "types": ["node"],
        "noEmit": true,
        // The cases are JSON, which the tests import as they are.
        "resolveJsonModule": true,
        "customConditions": ["@gametabletally/source"]
    },
    "include": ["src", "cases", "options", "released"]
}
