{
    "name": "gametabletally",
    "private": true,
    "description": "A scorekeeper for the game table: tap in each round and the app applies the game's scoring rules, on one phone with no connection needed.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=@gametabletally/web",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "test": "vitest",
        "build": "npm run build --workspaces --if-present",
        "verify": "npm run type-check --workspaces && tsc -p scripts && eslint . && prettier --check . && node scripts/check-prose.mjs && node scripts/check-node.mjs && vitest run && npm run build && npm run cases:outside-node",
        "prepare": "husky || true",
        "cases:outside-node": "npm run cases:outside-node --workspace=@gametabletally/scoring"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "10.14.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "fake-indexeddb": "^6.2.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "quickjs-emscripten-core": "0.32.0",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,html}": [
            "prettier --write"
        ]
    },
    "allowScripts": {
        "unrs-resolver": true,
        "fsevents": true
    }
}
