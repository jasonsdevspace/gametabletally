{
    "name": "gametabletally",
    "private": true,
    "description": "A scorekeeper for the game table: tap in each round and the app applies the game's scoring rules, on one phone with no connection needed.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=@gametabletally/web",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "test": "vitest",
        "build": "npm run build --workspaces --if-present",
        "prose": "check-prose",
        "node-check": "node scripts/check-node.mjs",
        "type-check": "npm run type-check --workspaces && tsc -p scripts",
        "lint": "eslint .",
        "format:check": "prettier --check .",
        "test:run": "vitest run",
        "verify": "npm run type-check && npm run lint && npm run format:check && npm run prose && npm run node-check && npm run test:run && npm run build && npm run cases:outside-node",
        "prepare": "husky || true",
        "cases:outside-node": "npm run cases:outside-node --workspace=@gametabletally/scoring",
        "e2e": "npm run build && npm run e2e --workspace=@gametabletally/web",
        "lighthouse": "npm run build && npm run lighthouse --workspace=@gametabletally/web"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@jasonsdevspace/prose-check": "0.3.0",
        "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
        "@playwright/test": "^1.65.1",
        "@testing-library/jest-dom": "^8.0.0",
        "@testing-library/react": "^16.3.3",
        "@types/node": "24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "axe-core": "^4.14.1",
        "chrome-launcher": "^1.2.3",
        "eslint": "10.15.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "fake-indexeddb": "^6.2.8",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.1",
        "lighthouse": "13.6.0",
        "lint-staged": "^17.6.1",
        "playwright-core": "1.65.1",
        "prettier": "3.10.1",
        "quickjs-emscripten-core": "0.32.0",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,html}": [
            "prettier --write"
        ]
    },
    "allowScripts": {
        "unrs-resolver": true,
        "fsevents": true
    }
}
